component PageHeader inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    height: 84px;
    background: transparent;

    VerticalLayout {
        spacing: 5px;
        Text {
            text: root.title;
            color: #ffffff;
            font-size: 34px;
            font-weight: 700;
        }

        Text {
            text: root.subtitle;
            color: #9eacc3;
            font-size: 16px;
        }
    }
}

component SettingsSection inherits Rectangle {
    in property <string> title;
    height: 28px;
    background: transparent;

    Text {
        text: root.title;
        color: #8fa6c8;
        font-size: 13px;
        font-weight: 700;
        vertical-alignment: center;
    }
}

component SettingStepper inherits Rectangle {
    in property <string> label;
    in property <string> detail;
    in-out property <int> value;
    in property <int> step: 1;
    callback value-changed(int);

    height: 66px;
    background: #18202d;
    border-radius: 16px;
    border-width: 1px;
    border-color: #2c3b52;

    VerticalLayout {
        padding-left: 16px;
        padding-right: 150px;
        alignment: center;
        spacing: 2px;
        Text {
            text: root.label;
            color: #f5f7fc;
            font-size: 16px;
            font-weight: 600;
        }

        Text {
            text: root.detail;
            color: #91a0b8;
            font-size: 13px;
        }
    }

    HorizontalLayout {
        x: parent.width - self.width - 8px;
        y: (parent.height - self.height) / 2;
        width: 142px;
        height: 38px;
        spacing: 8px;

        Rectangle {
            width: 34px;
            height: 34px;
            border-radius: 11px;
            background: #26364d;
            Text {
                text: "-";
                color: #dce6f8;
                font-size: 22px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            TouchArea {
                clicked => {
                    if root.value > 0 {
                        root.value = max(0, root.value - root.step);
                        root.value-changed(root.value);
                    }
                }
            }
        }

        Text {
            text: root.value + "%";
            width: 48px;
            color: #ffffff;
            font-size: 15px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        Rectangle {
            width: 34px;
            height: 34px;
            border-radius: 11px;
            background: #26364d;
            Text {
                text: "+";
                color: #dce6f8;
                font-size: 22px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            TouchArea {
                clicked => {
                    if root.value < 100 {
                        root.value = min(100, root.value + root.step);
                        root.value-changed(root.value);
                    }
                }
            }
        }
    }
}

component SettingChoice inherits Rectangle {
    in property <string> label;
    in property <string> detail;
    in property <string> value;
    in property <bool> selected;
    callback clicked();

    height: 66px;
    background: #18202d;
    border-radius: 16px;
    border-width: 1px;
    border-color: root.selected ? #9fc2ff : #2c3b52;

    VerticalLayout {
        padding-left: 16px;
        padding-right: 150px;
        alignment: center;
        spacing: 2px;
        Text {
            text: root.label;
            color: #f5f7fc;
            font-size: 16px;
            font-weight: 600;
        }

        Text {
            text: root.detail;
            color: #91a0b8;
            font-size: 13px;
        }
    }

    Text {
        text: root.value + "  >";
        x: parent.width - self.width - 16px;
        y: (parent.height - self.height) / 2;
        color: #9fc2ff;
        font-size: 15px;
        horizontal-alignment: right;
    }

    TouchArea {
        clicked => { root.clicked(); }
    }
}

struct BackgroundEntry {
    name: string,
    preview: image,
    is-video: bool,
    category: string,
}

struct BackgroundCategory {
    name: string,
    entries: [BackgroundEntry],
}

component BackgroundCard inherits Rectangle {
    in property <BackgroundEntry> entry;
    in property <bool> selected;
    callback clicked();

    width: 250px;
    height: 190px;
    border-radius: 18px;
    border-width: 2px;
    border-color: root.selected ? #9fc2ff : #2c3b52;
    background: #18202d;

    Image {
        source: root.entry.preview;
        x: 8px;
        y: 8px;
        width: parent.width - 16px;
        height: 132px;
        image-fit: cover;
        visible: root.entry.preview.width > 0;
    }

    Rectangle {
        x: 8px;
        y: 8px;
        width: parent.width - 16px;
        height: 132px;
        background: #26364d;
        visible: root.entry.preview.width == 0;

        Text {
            text: root.entry.is-video ? "▶" : "?";
            color: #9fc2ff;
            font-size: 42px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    Text {
        text: root.entry.name;
        x: 16px;
        y: 148px;
        width: parent.width - 32px;
        color: #f5f7fc;
        font-size: 16px;
        font-weight: 600;
        horizontal-alignment: center;
    }

    Text {
        text: root.selected ? "Selected" : "Select";
        x: 16px;
        y: 169px;
        width: parent.width - 32px;
        color: #9fc2ff;
        font-size: 12px;
        horizontal-alignment: center;
    }

    TouchArea {
        clicked => { root.clicked(); }
    }
}

component SettingsPage inherits Rectangle {
    in-out property <int> music-volume: 58;
    in-out property <int> headphones-volume: 42;
    in-out property <int> other-volume: 25;
    in-out property <bool> bluetooth-enabled: true;
    in-out property <int> background-overlay-opacity: 25;
    in-out property <int> video-speed-percent: 100;
    in property <[string]> background-options;
    in property <string> background-name;
    callback music-volume-changed(int);
    callback headphones-volume-changed(int);
    callback other-volume-changed(int);
    callback bluetooth-enabled-changed(bool);
    callback background-overlay-opacity-changed(int);
    callback video-speed-percent-changed(int);
    callback background-selected(string);
    callback backgrounds-requested();
    callback back-requested();

    background: transparent;

    VerticalLayout {
        spacing: 9px;
        PageHeader {
            title: "Settings";
            subtitle: "Tune the player to your setup";
        }

        Rectangle {
            width: 140px;
            height: 42px;
            border-radius: 12px;
            background: #26364d;

            Text {
                text: "<  Back";
                color: #dce6f8;
                font-size: 15px;
                font-weight: 600;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            TouchArea {
                clicked => { root.back-requested(); }
            }
        }

        Flickable {
            width: 100%;
            vertical-stretch: 1;
            interactive: true;
            mouse-drag-pan-enabled: true;
            content-width: parent.width;
            content-height: 720px;

            VerticalLayout {
                width: 100%;
                height: 720px;
                spacing: 9px;

                SettingsSection {
                    title: "AUDIO";
                }

                SettingStepper {
                    label: "Music volume";
                    detail: "Playback and local music";
                    value: root.music-volume;
                    value-changed(value) => { root.music-volume = value; root.music-volume-changed(value); }
                }

                SettingStepper {
                    label: "Headphones";
                    detail: "Headphone output level";
                    value: root.headphones-volume;
                    value-changed(value) => { root.headphones-volume = value; root.headphones-volume-changed(value); }
                }

                SettingStepper {
                    label: "Other volume";
                    detail: "System sounds and alerts";
                    value: root.other-volume;
                    value-changed(value) => { root.other-volume = value; root.other-volume-changed(value); }
                }

                SettingsSection {
                    title: "OUTPUT";
                }

                SettingChoice {
                    label: "Background";
                    detail: "Choose an image or video wallpaper";
                    value: root.background-name;
                    selected: false;
                    clicked => { root.backgrounds-requested(); }
                }

                SettingStepper {
                    label: "Background dimming";
                    detail: "Dark overlay for bright backgrounds";
                    value: root.background-overlay-opacity;
                    step: 5;
                    value-changed(value) => {
                        root.background-overlay-opacity = value;
                        root.background-overlay-opacity-changed(value);
                    }
                }

                SettingStepper {
                    label: "Video speed";
                    detail: "Wallpaper playback speed";
                    value: root.video-speed-percent;
                    step: 5;
                    value-changed(value) => {
                        root.video-speed-percent = value;
                        root.video-speed-percent-changed(value);
                    }
                }

                SettingChoice {
                    label: "Playing device";
                    detail: "Where audio is sent right now";
                    value: "Headphones";
                    clicked => {}
                }

                SettingChoice {
                    label: "Bluetooth audio";
                    detail: root.bluetooth-enabled ? "Ready to connect" : "Bluetooth is off";
                    value: root.bluetooth-enabled ? "On" : "Off";
                    clicked => { root.bluetooth-enabled = !root.bluetooth-enabled; root.bluetooth-enabled-changed(root.bluetooth-enabled); }
                }

                SettingsSection {
                    title: "DEVICE";
                }

                SettingChoice {
                    label: "Bluetooth devices";
                    detail: "Pair and manage audio devices";
                    value: "Manage";
                    clicked => {}
                }

                SettingChoice {
                    label: "Keyboard";
                    detail: "Layout and key behaviour";
                    value: "US English";
                    clicked => {}
                }

                Rectangle {
                    height: 1px;
                    background: transparent;
                }

                Text {
                    text: "System controls will connect to Raspberry Pi services here.";
                    color: #71819a;
                    font-size: 12px;
                }
            }
        }
    }
}

component BackgroundsPage inherits Rectangle {
    in property <[BackgroundEntry]> animated-entries;
    in property <[BackgroundEntry]> still-entries;
    in property <[BackgroundCategory]> still-categories;
    in property <string> selected-name;
    property <bool> animated-tab: false;
    property <string> still-category: root.still-categories.length > 0
        ? root.still-categories[0].name
        : "";
    property <[BackgroundEntry]> selected-still-entries: root.still-categories.length > 0
        ? root.still-categories[0].entries
        : [];
    callback background-selected(string);
    callback back-requested();

    background: transparent;

    VerticalLayout {
        spacing: 14px;

        PageHeader {
            title: "Backgrounds";
            subtitle: "Choose a background for MusicPi";
        }

        Rectangle {
            width: 140px;
            height: 42px;
            border-radius: 12px;
            background: #26364d;

            Text {
                text: "<  Back";
                color: #dce6f8;
                font-size: 15px;
                font-weight: 600;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            TouchArea {
                clicked => { root.back-requested(); }
            }
        }

        HorizontalLayout {
            height: 42px;
            spacing: 8px;

            Rectangle {
                width: 150px;
                border-radius: 12px;
                background: root.animated-tab ? #26364d : #9fc2ff;
                Text {
                    text: "Still";
                    color: root.animated-tab ? #dce6f8 : #101722;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                TouchArea {
                    clicked => { root.animated-tab = false; }
                }
            }

            Rectangle {
                width: 150px;
                border-radius: 12px;
                background: root.animated-tab ? #9fc2ff : #26364d;
                Text {
                    text: "Animated";
                    color: root.animated-tab ? #101722 : #dce6f8;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                TouchArea {
                    clicked => { root.animated-tab = true; }
                }
            }
        }

        if !root.animated-tab: Flickable {
            width: 100%;
            height: 42px;
            interactive: true;
            mouse-drag-pan-enabled: true;
            content-width: root.still-categories.length * 158px;
            content-height: 42px;

            HorizontalLayout {
                width: root.still-categories.length * 158px;
                spacing: 8px;

                for category in root.still-categories: Rectangle {
                    width: 150px;
                    border-radius: 12px;
                    background: root.still-category == category.name ? #9fc2ff : #26364d;
                    Text {
                        text: category.name;
                        color: root.still-category == category.name ? #101722 : #dce6f8;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    TouchArea {
                        clicked => {
                            root.still-category = category.name;
                            root.selected-still-entries = category.entries;
                        }
                    }
                }
            }
        }

        Flickable {
            width: 100%;
            vertical-stretch: 1;
            interactive: true;
            mouse-drag-pan-enabled: true;
            content-width: 514px;
            content-height: ((root.animated-tab
                ? root.animated-entries.length
                : root.selected-still-entries.length) + 1) / 2 * 204px;

            grid := GridLayout {
                width: 514px;
                spacing: 14px;
                for entry[index] in root.animated-tab
                    ? root.animated-entries
                    : root.selected-still-entries: BackgroundCard {
                    col: index.mod(2);
                    row: index / 2;
                    entry: entry;
                    selected: entry.name == root.selected-name;
                    clicked => { root.background-selected(entry.name); }
                }
            }
        }
    }
}

