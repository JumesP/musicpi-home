component AppTile inherits Rectangle {
    in property <string> symbol;
    in property <string> label;
    in property <color> tint;
    callback clicked();

    width: 267px;
    height: 236px;
    background: #18202d;
    border-radius: 22px;
    border-width: 1px;
    border-color: #314057;

    VerticalLayout {
        padding: 20px;
        alignment: center;
        spacing: 14px;

        HorizontalLayout {
            height: 100px;
            alignment: center;

            Rectangle {
                width: 100px;
                height: 100px;
                border-radius: 28px;
                background: root.tint;

                Text {
                    width: parent.width;
                    height: parent.height;
                    text: root.symbol;
                    color: #ffffff;
                    font-size: 52px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        Text {
            width: 100%;
            text: root.label;
            color: #f4f6ff;
            font-size: 18px;
            font-weight: 600;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
    }

    TouchArea {
        clicked => { root.clicked(); }
    }
}

component PageHeader inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    height: 84px;
    background: transparent;

    VerticalLayout {
        spacing: 5px;
        Text {
            text: root.title;
            color: #ffffff;
            font-size: 34px;
            font-weight: 700;
        }

        Text {
            text: root.subtitle;
            color: #9eacc3;
            font-size: 16px;
        }
    }
}

component SettingsSection inherits Rectangle {
    in property <string> title;
    height: 28px;
    background: transparent;

    Text {
        text: root.title;
        color: #8fa6c8;
        font-size: 13px;
        font-weight: 700;
        vertical-alignment: center;
    }
}

component SettingStepper inherits Rectangle {
    in property <string> label;
    in property <string> detail;
    in-out property <int> value;
    callback value-changed(int);

    height: 66px;
    background: #18202d;
    border-radius: 16px;
    border-width: 1px;
    border-color: #2c3b52;

    VerticalLayout {
        padding-left: 16px;
        padding-right: 150px;
        alignment: center;
        spacing: 2px;
        Text {
            text: root.label;
            color: #f5f7fc;
            font-size: 16px;
            font-weight: 600;
        }

        Text {
            text: root.detail;
            color: #91a0b8;
            font-size: 13px;
        }
    }

    HorizontalLayout {
        x: parent.width - self.width - 8px;
        y: (parent.height - self.height) / 2;
        width: 142px;
        height: 38px;
        spacing: 8px;

        Rectangle {
            width: 34px;
            height: 34px;
            border-radius: 11px;
            background: #26364d;
            Text {
                text: "-";
                color: #dce6f8;
                font-size: 22px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            TouchArea {
                clicked => {
                    if root.value > 0 {
                        root.value = root.value - 1;
                        root.value-changed(root.value);
                    }
                }
            }
        }

        Text {
            text: root.value + "%";
            width: 48px;
            color: #ffffff;
            font-size: 15px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        Rectangle {
            width: 34px;
            height: 34px;
            border-radius: 11px;
            background: #26364d;
            Text {
                text: "+";
                color: #dce6f8;
                font-size: 22px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            TouchArea {
                clicked => {
                    if root.value < 100 {
                        root.value = root.value + 1;
                        root.value-changed(root.value);
                    }
                }
            }
        }
    }
}

component SettingChoice inherits Rectangle {
    in property <string> label;
    in property <string> detail;
    in property <string> value;
    callback clicked();

    height: 66px;
    background: #18202d;
    border-radius: 16px;
    border-width: 1px;
    border-color: #2c3b52;

    VerticalLayout {
        padding-left: 16px;
        padding-right: 150px;
        alignment: center;
        spacing: 2px;
        Text {
            text: root.label;
            color: #f5f7fc;
            font-size: 16px;
            font-weight: 600;
        }

        Text {
            text: root.detail;
            color: #91a0b8;
            font-size: 13px;
        }
    }

    Text {
        text: root.value + "  >";
        x: parent.width - self.width - 16px;
        y: (parent.height - self.height) / 2;
        color: #9fc2ff;
        font-size: 15px;
        horizontal-alignment: right;
    }

    TouchArea {
        clicked => { root.clicked(); }
    }
}

component SettingsPage inherits Rectangle {
    in-out property <int> music-volume: 58;
    in-out property <int> headphones-volume: 42;
    in-out property <int> other-volume: 25;
    in-out property <bool> bluetooth-enabled: true;
    callback music-volume-changed(int);
    callback headphones-volume-changed(int);
    callback other-volume-changed(int);
    callback bluetooth-enabled-changed(bool);

    background: transparent;

    VerticalLayout {
        spacing: 9px;
        PageHeader {
            title: "Settings";
            subtitle: "Tune the player to your setup";
        }

        SettingsSection {
            title: "AUDIO";
        }

        SettingStepper {
            label: "Music volume";
            detail: "Playback and local music";
            value: root.music-volume;
            value-changed(value) => { root.music-volume = value; root.music-volume-changed(value); }
        }

        SettingStepper {
            label: "Headphones";
            detail: "Headphone output level";
            value: root.headphones-volume;
            value-changed(value) => { root.headphones-volume = value; root.headphones-volume-changed(value); }
        }

        SettingStepper {
            label: "Other volume";
            detail: "System sounds and alerts";
            value: root.other-volume;
            value-changed(value) => { root.other-volume = value; root.other-volume-changed(value); }
        }

        SettingsSection {
            title: "OUTPUT";
        }

        SettingChoice {
            label: "Playing device";
            detail: "Where audio is sent right now";
            value: "Headphones";
            clicked => {}
        }

        SettingChoice {
            label: "Bluetooth audio";
            detail: root.bluetooth-enabled ? "Ready to connect" : "Bluetooth is off";
            value: root.bluetooth-enabled ? "On" : "Off";
            clicked => { root.bluetooth-enabled = !root.bluetooth-enabled; root.bluetooth-enabled-changed(root.bluetooth-enabled); }
        }

        SettingsSection {
            title: "DEVICE";
        }

        SettingChoice {
            label: "Bluetooth devices";
            detail: "Pair and manage audio devices";
            value: "Manage";
            clicked => {}
        }

        SettingChoice {
            label: "Keyboard";
            detail: "Layout and key behaviour";
            value: "US English";
            clicked => {}
        }

        Rectangle {
            height: 1px;
            background: transparent;
        }

        Text {
            text: "System controls will connect to Raspberry Pi services here.";
            color: #71819a;
            font-size: 12px;
        }
    }
}

component PlaceholderPage inherits Rectangle {
    in property <string> title;
    in property <string> symbol;
    in property <string> description;
    callback home-requested();
    background: transparent;

    VerticalLayout {
        alignment: center;
        spacing: 16px;
        Text {
            text: root.symbol;
            color: #9fc2ff;
            font-size: 64px;
            horizontal-alignment: center;
        }

        Text {
            text: root.title;
            color: #ffffff;
            font-size: 30px;
            font-weight: 700;
            horizontal-alignment: center;
        }

        Text {
            text: root.description;
            color: #9eacc3;
            font-size: 16px;
            horizontal-alignment: center;
            wrap: word-wrap;
        }

