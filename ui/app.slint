component ImmersiveToggle inherits Rectangle {
    in property <bool> immersive;
    callback clicked();

    width: 48px;
    height: 48px;
    border-radius: 14px;
    background: #18202dcc;
    border-width: 1px;
    border-color: #ffffff33;

    Text {
        text: root.immersive ? "×" : "⛶";
        width: parent.width;
        height: parent.height;
        color: #ffffff;
        font-size: root.immersive ? 27px : 22px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    TouchArea {
        clicked => { root.clicked(); }
    }
}

component NowPlayingPreview inherits Rectangle {
    in property <string> title: "Nothing playing";
    in property <string> artist: "Cadence";
    in property <string> album: "";
    in property <string> player: "cadence";
    in property <image> artwork;
    in property <float> progress: 0.0;
    in property <bool> playing: false;
    callback open();
    callback toggle();

    width: 100%;
    height: 100px;
    background: #18202dcc;
    border-radius: 12px;
    border-width: 1px;
    border-color: #ffffff33;

    TouchArea {
        clicked => { root.open(); }
    }

    // Artwork
    Rectangle {
        x: 14px;
        y: 14px;
        width: 58px;
        height: 58px;
        border-radius: 6px;
        background: #26364d;
        clip: true;

        if root.artwork.width > 0: Image {
            source: root.artwork;
            width: parent.width;
            height: parent.height;
            image-fit: contain;
        }

        if root.artwork.width == 0: Text {
            text: "♪";
            width: parent.width;
            height: parent.height;
            color: #91a0b8;
            font-size: 28px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    // Song info
    VerticalLayout {
        x: 88px;
        y: 14px;
        width: parent.width - 160px;
        height: 58px;
        spacing: 3px;

        Text {
            text: root.playing ? "Now playing · " + root.player : "Audio preview · " + root.player;
            color: #9fc2ff;
            font-size: 12px;
            font-weight: 700;
        }

        Text {
            text: root.title;
            color: #f5f7fc;
            font-size: 16px;
            font-weight: 600;
            overflow: elide;
        }

        Text {
            text: root.artist + (root.album == "" ? "" : "  ·  " + root.album);
            color: #91a0b8;
            font-size: 13px;
            overflow: elide;
        }
    }

    // Pause and Play Button
    // Rectangle {
    //     x: parent.width - 62px;
    //     y: 19px;
    //     width: 48px;
    //     height: 48px;
    //     border-radius: 4px;
    //     border-width: 1px;
    //     border-color: #9fc2ff;

    //     Text {
    //         text: root.playing ? "||" : ">";
    //         width: parent.width;
    //         height: parent.height;
    //         color: #9fc2ff;
    //         font-size: root.playing ? 17px : 22px;
    //         font-weight: 700;
    //         horizontal-alignment: center;
    //         vertical-alignment: center;
    //     }

    //     TouchArea {
    //         clicked => { root.toggle(); }
    //     }
    // }

    // Progress bar
    Rectangle {
        x: 14px;
        y: parent.height - 18px;
        width: parent.width * clamp(root.progress, 0.0, 1.0) - 28px;
        height: 3px;
        background: #9fc2ff;
        border-radius: 1px;
    }
}

component ExpandedPlayerPage inherits Rectangle {
    in property <string> title;
    in property <string> artist;
    in property <string> album;
    in property <string> player: "cadence";
    in property <image> artwork;
    in property <float> progress: 0.0;
    in property <bool> playing: false;
    property <length> player-drag-offset: 0px;
    property <length> drag-start-y: 0px;
    property <bool> dragging-player: false;
    property <bool> player-was-dragged: false;
    callback back();
    callback toggle();

    x: 0px;
    y: root.player-drag-offset;
    width: 100%;
    height: 100%;
    background: #18202de6;

    Rectangle {
        x: (parent.width - 48px) / 2;
        y: 16px;
        width: 48px;
        height: 4px;
        border-radius: 2px;
        background: #91a0b8;
    }

    // Keep the drag target above the visual handle so mouse and touch input
    // is captured by the gesture area itself.
    TouchArea {
        x: (parent.width - 120px) / 2;
        y: 0px;
        width: 120px;
        height: 56px;

        moved => {
            if self.pressed {
                if !root.dragging-player {
                    root.drag-start-y = self.mouse-y;
                    root.dragging-player = true;
                }
                root.player-was-dragged = true;
                root.player-drag-offset = clamp(
                    root.player-drag-offset + self.mouse-y - root.drag-start-y,
                    0px,
                    parent.height - 72px);
            }
        }

        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                root.drag-start-y = self.mouse-y;
                root.dragging-player = true;
                root.player-was-dragged = false;
            }
            if event.kind == PointerEventKind.move {
                if root.dragging-player {
                    root.player-was-dragged = true;
                    root.player-drag-offset = clamp(
                        root.player-drag-offset + self.mouse-y - root.drag-start-y,
                        0px,
                        parent.height - 72px);
                }
            }
            if event.kind == PointerEventKind.up {
                if root.dragging-player {
                    if root.player-drag-offset > parent.height * 0.35 {
                        root.back();
                    } else {
                        root.player-drag-offset = 0px;
                    }
                }
                root.dragging-player = false;
            }
        }

        clicked => {
            if !root.player-was-dragged {
                root.back();
            }
        }
    }

    Rectangle {
        x: 0px;
        y: 56px;
        width: parent.width - 36px;
        height: parent.height - 72px;
        background: transparent;

        VerticalLayout {
            padding-left: 18px;
            padding-right: 18px;
            padding-top: 22px;
            padding-bottom: 24px;
            spacing: 18px;

            Text {
                text: "Now playing · " + root.player;
                width: parent.width;
                color: #9fc2ff;
                font-size: 14px;
                font-weight: 700;
                horizontal-alignment: center;
            }

            // Artwork
            Rectangle {
                width: parent.width;
                height: self.width;
                border-radius: 16px;
                background: #26364d;
                clip: true;

                if root.artwork.width > 0: Image {
                    source: root.artwork;
                    width: parent.width;
                    height: parent.height;
                    image-fit: contain;
                }

                if root.artwork.width == 0: Text {
                    text: "♪";
                    width: parent.width;
                    height: parent.height;
                    color: #91a0b8;
                    font-size: 96px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            // Song info
            Text {
                text: root.title;
                width: parent.width;
                color: #ffffff;
                font-size: 25px;
                font-weight: 700;
                horizontal-alignment: center;
                overflow: elide;
            }

            Text {
                text: root.artist + (root.album == "" ? "" : "  ·  " + root.album);
                width: parent.width;
                color: #aebbd0;
                font-size: 16px;
                horizontal-alignment: center;
                overflow: elide;
            }

            // Progress bar
            Rectangle {
                width: parent.width;
                height: 4px;
                background: #40516b;

                Rectangle {
                    x: 0px;
                    width: parent.width * clamp(root.progress, 0.0, 1.0);
                    height: parent.height;
                    background: #9fc2ff;
                }
            }

            // Play/Pause button
            // Rectangle {
            //     x: (parent.width - self.width) / 2;
            //     width: 58px;
            //     height: 58px;
            //     border-radius: 29px;
            //     background: #9fc2ff;

            //     Text {
            //         text: root.playing ? "||" : ">";
            //         width: parent.width;
            //         height: parent.height;
            //         color: #18202d;
            //         font-size: root.playing ? 20px : 28px;
            //         font-weight: 700;
            //         horizontal-alignment: center;
            //         vertical-alignment: center;
            //     }

            //     TouchArea {
            //         clicked => { root.toggle(); }
            //     }
            // }
        }
    }
}

export component MainWindow inherits Window {
    title: "MusicPi Home";
    width: 600px;
    height: 1024px - 80px;
    background: transparent;

    in-out property <string> current-page: "Home";
    in-out property <bool> immersive: false;
    in-out property <bool> super-immersive: false;
    in-out property <bool> player-expanded: false;
    property <[string]> subtitle-phrases: [
        "Soundtrack to Your Day",
        "Turn Up the Volume",
        "Your Personal Jukebox",
        "Press Play, Escape Reality",
        "Rhythm & Energy",
        "Press Play & Unwind",
        "What Are We Listening To?",
        "Tune In, Turn Up",
        "Good Vibes Only",
        "All Your Favorites, One Place",
        "Set the Mood",
        "Pure Audio Euphoria",
        "Your Daily Soundtrack",
        "Lost in the Music",
        "Now Streaming",
    ];
    property <int> subtitle-index: 0;
    property <int> music-volume: 58;
    property <int> headphones-volume: 42;
    property <int> other-volume: 25;
    property <bool> bluetooth-enabled: true;
    in-out property <int> background-overlay-opacity: 25;
    in-out property <int> video-speed-percent: 100;
    in-out property <string> now-playing-title: "Nothing playing";
    in-out property <string> now-playing-artist: "Cadence";
    in-out property <string> now-playing-album: "";
    in-out property <string> now-playing-player: "cadence";
    in-out property <bool> now-playing: false;
    in-out property <image> now-playing-artwork;
    in-out property <float> now-playing-progress: 0.0;
    in-out property <image> background-image;
    in-out property <[string]> background-options;
    in-out property <string> background-name;
    in-out property <[BackgroundEntry]> background-entries;
    in-out property <[BackgroundEntry]> animated-background-entries;
    in-out property <[BackgroundEntry]> still-background-entries;
    in-out property <[BackgroundCategory]> still-categories;
    callback open-local-music();
    callback open-spotify();
    callback open-video();
    callback background-selected(string);
    callback background-overlay-opacity-changed(int);
    callback video-speed-percent-changed(int);

    Timer {
        interval: 5s;
        running: true;
        triggered => {
            root.subtitle-index = Math.mod(
                root.subtitle-index + 1,
                root.subtitle-phrases.length
            );
        }
    }

    Rectangle {
        width: parent.width;
        height: parent.height;
        background: transparent;

        Image {
            source: root.background-image;
            width: parent.width;
            height: parent.height;
        }

        Rectangle {
            width: parent.width;
            height: parent.height;
            background: #161b22.with-alpha(root.background-overlay-opacity / 100.0);
        }

        TouchArea {
            width: parent.width;
            height: parent.height;
        }
    }

    ImmersiveToggle {
        x: parent.width - self.width - 24px;
        y: 24px;
        immersive: root.immersive || root.super-immersive;
        clicked => {
            if root.super-immersive {
                root.super-immersive = false;
            } else {
                root.immersive = !root.immersive;
            }
        }
    }

    if root.immersive: ImmersiveToggle {
        x: parent.width - self.width - 24px;
        y: 84px;
        immersive: root.super-immersive;
        clicked => {
            if root.super-immersive {
                root.super-immersive = false;
            } else {
                root.super-immersive = true;
            }
        }
    }

    VerticalLayout {
        padding: 24px;
        spacing: 0px;

        if !root.super-immersive: Rectangle {
            if root.current-page == "Home": VerticalLayout {
                spacing: 18px;
                alignment: space-between;

                PageHeader {
                    title: "MusicPi";
                    subtitle: root.subtitle-phrases[root.subtitle-index];
                }

                VerticalLayout {
                    if !root.immersive: AppTiles {
                        padding-bottom: 18px;
                        current-page: root.current-page;
                        open-local-music => { root.current-page = "Local Music"; root.open-local-music(); }
                        open-spotify => { root.current-page = "Spotify"; root.open-spotify(); }
                        open-video => { root.current-page = "Video"; root.open-video(); }
                        open-settings => { root.current-page = "Settings"; }
                    }

                    VerticalLayout {
                        spacing: 10px;

                        NowPlayingPreview {
                            width: 100%;
                            title: root.now-playing-title;
                            artist: root.now-playing-artist;
                            album: root.now-playing-album;
                            player: root.now-playing-player;
                            artwork: root.now-playing-artwork;
                            progress: root.now-playing-progress;
                            playing: root.now-playing;
                            open => { root.player-expanded = true; }
                            toggle => {}
                        }
                    }
                }
            }

            if root.current-page == "Settings": SettingsPage {
                music-volume: root.music-volume;
                headphones-volume: root.headphones-volume;
                other-volume: root.other-volume;
                bluetooth-enabled: root.bluetooth-enabled;
                background-overlay-opacity: root.background-overlay-opacity;
                video-speed-percent: root.video-speed-percent;
                background-options: root.background-options;
                background-name: root.background-name;
                music-volume-changed(value) => { root.music-volume = value; }
                headphones-volume-changed(value) => { root.headphones-volume = value; }
                other-volume-changed(value) => { root.other-volume = value; }
                bluetooth-enabled-changed(value) => { root.bluetooth-enabled = value; }
                background-selected(value) => { root.background-selected(value); }
                background-overlay-opacity-changed(value) => {
                    root.background-overlay-opacity = value;
                    root.background-overlay-opacity-changed(value);
                }
                video-speed-percent-changed(value) => {
                    root.video-speed-percent = value;
                    root.video-speed-percent-changed(value);
                }
                backgrounds-requested => { root.current-page = "Backgrounds"; }
                back-requested => { root.current-page = "Home"; }
            }

            if root.current-page == "Backgrounds": BackgroundsPage {
                animated-entries: root.animated-background-entries;
                still-entries: root.still-background-entries;
                still-categories: root.still-categories;
                selected-name: root.background-name;
                background-selected(value) => {
                    root.background-selected(value);
                    root.current-page = "Settings";
                }
                back-requested => { root.current-page = "Settings"; }
            }

            if root.current-page == "Local Music": PlaceholderPage {
                title: "Local Music";
                symbol: "♫";
                description: "Your local library will appear here when music services are connected.";
                home-requested => { root.current-page = "Home"; }
            }

            if root.current-page == "Spotify": PlaceholderPage {
                title: "Spotify";
                symbol: "≋";
                description: "Spotify controls are not connected yet. This space is ready for integration.";
                home-requested => { root.current-page = "Home"; }
            }

            if root.current-page == "Video": PlaceholderPage {
                title: "Video";
                symbol: "▶";
                description: "MPV playback will be controlled here while the wallpaper remains independent.";
                home-requested => { root.current-page = "Home"; }
            }
        }

        Rectangle {
            height: 1px;
            background: transparent;
        }
    }

    if root.player-expanded: ExpandedPlayerPage {
        title: root.now-playing-title;
        artist: root.now-playing-artist;
        album: root.now-playing-album;
        player: root.now-playing-player;
        artwork: root.now-playing-artwork;
        progress: root.now-playing-progress;
        playing: root.now-playing;
        back => { root.player-expanded = false; }
        toggle => {}
    }
}
