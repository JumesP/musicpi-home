component AppTile inherits Rectangle {
    in property <string> symbol;
    in property <image> icon;
    in property <string> label;
    in property <color> tint;
    in property <brush> tile-background;
    in property <color> icon-color: #ffffff;
    in property <bool> colorize-icon: true;
    callback clicked();

    width: 267px;
    height: 236px;
    // opacity: 0.75;
    // background: root.tile-background;
    // border-radius: 26px;
    // border-width: 1px;
    // border-color: #263247;
    // clip: true;

    // Base tile styling
    background: #1e222d;
    border-radius: 12px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.1);

    VerticalLayout {
        padding: 20px;
        alignment: center;
        spacing: 14px;

        HorizontalLayout {
            height: 100px;
            alignment: center;

            // App icon or symbol
            Rectangle {
                width: 100px;
                height: 100px;
                border-radius: 24px;
                // background: root.tile-background;
                clip: true;

                if root.icon.width > 0 && root.colorize-icon: Image {
                    source: root.icon;
                    width: 100%;
                    height: 100%;
                    image-fit: contain;
                    colorize: root.icon-color;
                }

                if root.icon.width > 0 && !root.colorize-icon: Image {
                    source: root.icon;
                    width: 100%;
                    height: 100%;
                    image-fit: contain;
                }

                if root.icon.width == 0: Text {
                    width: 100%;
                    height: 100%;
                    text: root.symbol;
                    color: #ffffff;
                    font-size: 52px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        // App label
        Text {
            width: 100%;
            text: root.label;
            color: #f4f6ff;
            font-size: 18px;
            font-weight: 600;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
    }

    TouchArea {
        clicked => { root.clicked(); }
    }
}

component AppTiles inherits VerticalLayout {
    in-out property <string> current-page;
    callback open-local-music();
    callback open-spotify();
    callback open-video();
    callback open-settings();
    spacing: 18px;

    HorizontalLayout {
        spacing: 18px;
        AppTile {
            label: "Local Music";
            icon: @image-url("../assets/app_icons/music-removebg-preview.png");
            tile-background: @linear-gradient(135deg, #1E3A8A, #172554);
            icon-color: #ffffff;
            clicked => { root.current-page = "Local Music"; root.open-local-music(); }
        }

        AppTile {
            label: "Spotify";
            icon: @image-url("../assets/app_icons/Spotify_App_Logo.png");
            tile-background: #15803D;
            icon-color: #ffffff;
            colorize-icon: false;
            clicked => { root.current-page = "Spotify"; root.open-spotify(); }
        }
    }

    HorizontalLayout {
        spacing: 18px;
        AppTile {
            label: "Video";
            icon: @image-url("../assets/app_icons/video.png");
            tile-background: @linear-gradient(135deg, #5B21B6, #3B0764);
            icon-color: #ffffff;
            clicked => { root.current-page = "Video"; root.open-video(); }
        }

        AppTile {
            label: "Settings";
            icon: @image-url("../assets/app_icons/settings.png");
            tile-background: @linear-gradient(135deg, #334155, #0F172A);
            icon-color: #ffffff;
            clicked => { root.open-settings(); }
        }
    }
}

